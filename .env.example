# Salin file ini menjadi .env.local lalu isi nilainya.
# Supabase Dashboard > Project Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...anon-key...

# Opsional: URL foto hero beranda (jika kosong, hero memakai gradasi biru muda)
NEXT_PUBLIC_HERO_IMAGE_URL=

# HANYA untuk skrip `npm run create-admin` (jalan di komputer Anda).
# JANGAN diberi awalan NEXT_PUBLIC_ dan JANGAN di-commit/deploy ke browser.
SUPABASE_SERVICE_ROLE_KEY=
